{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runbook.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "maxRules": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "maxClauses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "args": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "required": [
          "id",
          "args"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "argTypes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "min": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          },
          "max": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          },
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "of": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "args": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "required": [
          "id",
          "args"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    },
    "selectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "for": {
            "type": "array",
            "items": {
              "enum": [
                "enemy",
                "ally",
                "self"
              ]
            },
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "for"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 30
    }
  },
  "required": [
    "version",
    "maxRules",
    "maxClauses",
    "conditions",
    "argTypes",
    "actions",
    "selectors"
  ],
  "additionalProperties": false
}
