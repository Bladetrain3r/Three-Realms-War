        "expeditionTierWeights": {
          "type": "object",
          "properties": {
            "plain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "fine": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "runed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "heirloom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "plain",
            "fine",
            "runed",
            "heirloom"
          ],
          "additionalProperties": false
