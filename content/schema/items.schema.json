    "stashMax": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "drops": {
      "type": "object",
      "properties": {
        "encounterBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "tierWeights": {
          "type": "object",
          "properties": {
            "plain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "fine": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "runed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "plain",
            "fine",
            "runed"
          ],
          "additionalProperties": false
        },
        "bossTierWeights": {
          "type": "object",
          "properties": {
            "fine": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
