  "required": [
    "format",
    "version",
    "meta",
    "rng",
    "nextId",
    "currency",
    "materials",
    "reputation",
    "unlocked",
    "heroes",
    "party",
    "items",
    "threads",
    "expedition"
  ],
  "additionalProperties": false
}
