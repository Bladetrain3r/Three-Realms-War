            "heirloom"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "encounterBp",
        "tierWeights",
        "bossTierWeights",
        "expeditionTierWeights",
        "expeditionBossTierWeights",
        "setTagBp"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "slots",
    "slotOrder",
    "tiers",
    "lines",
    "sets",
    "starBonusBp",
    "starSuccessBp",
    "upgradeCost",
    "levelSlack",
    "stashMax",
    "drops"
  ],
  "additionalProperties": false
}
