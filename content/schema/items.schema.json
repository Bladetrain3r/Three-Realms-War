        "commonDivisor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "rareFromStar": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "highStarFrom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "highStarMul": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "commonBase",
        "commonDivisor",
        "rareFromStar",
        "highStarFrom",
        "highStarMul"
      ],
      "additionalProperties": false
