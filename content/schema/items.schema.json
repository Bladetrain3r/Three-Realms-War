{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "items.json",
  "type": "object",
  "properties": {
    "slots": {
      "type": "object",
      "properties": {
        "weapon": {
          "type": "object",
          "properties": {
            "main": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stat": {
                    "enum": [
                      "VIG",
                      "MIT",
                      "ARC",
                      "GRD",
                      "WRD",
                      "SPD",
                      "MIT_OR_ARC"
                    ]
                  },
                  "coef": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                },
                "required": [
                  "stat",
                  "coef"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 3
            }
          },
          "required": [
            "main"
          ],
          "additionalProperties": false
        },
        "armour": {
          "type": "object",
          "properties": {
            "main": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stat": {
                    "enum": [
                      "VIG",
                      "MIT",
                      "ARC",
                      "GRD",
                      "WRD",
                      "SPD",
                      "MIT_OR_ARC"
                    ]
                  },
                  "coef": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                },
                "required": [
                  "stat",
                  "coef"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 3
            }
          },
          "required": [
            "main"
          ],
          "additionalProperties": false
        },
        "helm": {
          "type": "object",
          "properties": {
            "main": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stat": {
                    "enum": [
                      "VIG",
                      "MIT",
                      "ARC",
                      "GRD",
                      "WRD",
                      "SPD",
                      "MIT_OR_ARC"
                    ]
                  },
                  "coef": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                },
                "required": [
                  "stat",
                  "coef"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 3
            }
          },
          "required": [
            "main"
          ],
          "additionalProperties": false
        },
        "charm": {
          "type": "object",
          "properties": {
            "main": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stat": {
                    "enum": [
                      "VIG",
                      "MIT",
                      "ARC",
                      "GRD",
                      "WRD",
                      "SPD",
                      "MIT_OR_ARC"
                    ]
                  },
                  "coef": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                },
                "required": [
                  "stat",
                  "coef"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 3
            },
            "resistBpPerLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [
            "main"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "weapon",
        "armour",
        "helm",
        "charm"
      ],
      "additionalProperties": false
    },
    "slotOrder": {
      "type": "array",
      "items": {
        "enum": [
          "weapon",
          "armour",
          "helm",
          "charm"
        ]
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "plain",
              "fine",
              "runed",
              "heirloom",
              "legendary"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "multiplierBp": {
            "type": "integer",
            "minimum": 10000,
            "maximum": 40000
          },
          "lines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "maxStar": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "setAllowed": {
            "type": "boolean"
          },
          "fixedLines": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "multiplierBp",
          "lines",
          "maxStar",
          "setAllowed"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "lo": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "hi": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "id": {
            "enum": [
              "VIG_PCT",
              "MIT_PCT",
              "ARC_PCT",
              "GRD_PCT",
              "WRD_PCT",
              "SPD_PCT",
              "CRIT",
              "CRITDMG",
              "SRES",
              "RES_REALM"
            ]
          }
        },
        "required": [
          "index",
          "lo",
          "hi",
          "id"
        ],
        "additionalProperties": false
      },
      "minItems": 10,
      "maxItems": 10
    },
    "sets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "realm": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "two": {
            "type": "object",
            "properties": {
              "mods": {
                "type": "object",
                "properties": {
                  "VIG": {
                    "type": "integer",
                    "minimum": -10000,
                    "maximum": 20000
                  },
                  "MIT": {
                    "type": "integer",
                    "minimum": -10000,
                    "maximum": 20000
                  },
                  "ARC": {
                    "type": "integer",
                    "minimum": -10000,
                    "maximum": 20000
                  },
                  "GRD": {
                    "type": "integer",
                    "minimum": -10000,
                    "maximum": 20000
                  },
                  "WRD": {
                    "type": "integer",
                    "minimum": -10000,
                    "maximum": 20000
                  },
                  "SPD": {
                    "type": "integer",
                    "minimum": -10000,
                    "maximum": 20000
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "res": {
                "type": "object",
                "properties": {
                  "fire": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "frost": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "lightning": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "sresBp": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "four": {
            "type": "object",
            "properties": {
              "skill": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "required": [
              "skill"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "realm",
          "two",
          "four"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    },
    "starBonusBp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    },
    "starSuccessBp": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      },
      "minItems": 7,
      "maxItems": 7
    },
    "upgradeCost": {
      "type": "object",
      "properties": {
        "commonBase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
